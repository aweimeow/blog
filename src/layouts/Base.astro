---
import '../styles/global.css';
import { site } from '../data/site';
const { title, description = site.description, schema, noindex = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, site.url).href;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name}’s Blog — AI & DevOps`;
const person = {
  '@type': 'Person', '@id': `${site.url}/#person`, name: site.name,
  url: site.url, jobTitle: site.role,
  knowsAbout: ['AI engineering', 'AI workflow design', 'DevOps', 'Amazon Web Services', 'Kubernetes', 'CI/CD'],
};
const graph = { '@context': 'https://schema.org', '@graph': [person, {
  '@type': 'WebSite', '@id': `${site.url}/#website`, url: site.url,
  name: site.name, description: site.description, inLanguage: 'en',
  publisher: { '@id': `${site.url}/#person` },
}, ...(schema ? [schema] : [])] };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#8c6652" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Wei-Yu Chen — Writing" href="/rss.xml" />
    <meta property="og:type" content={schema?.['@type'] === 'BlogPosting' ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={`${site.name}’s Blog`} />
    <meta property="og:image" content={`${site.url}/social.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Wei-Yu Chen’s Blog. Notes on AI engineering, DevOps, and systems." />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header"><div class="wrap header-inner">
      <a class="wordmark" href="/" aria-label="Wei-Yu Chen, home">Wei-Yu Chen<span>’s Blog</span></a>
      <nav aria-label="Main navigation">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
        <a href="/archives/" aria-current={path.startsWith('/archives') ? 'page' : undefined}>Archives</a>
        <a href="/categories/" aria-current={path.startsWith('/categories') ? 'page' : undefined}>Topics</a>
        <a href="/about/" aria-current={path === '/about/' ? 'page' : undefined}>About</a>
      </nav>
      <a class="header-email" href="/contact/" aria-label="Contact Wei-Yu"><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></svg></a>
    </div></header>
    <main id="main"><slot /></main>
    <footer class="wrap site-footer">
      <div><a class="footer-name" href="/">Wei-Yu Chen’s Blog</a><p>Notes on AI, DevOps, and the things learned along the way.</p></div>
      <div class="footer-links"><a href="/contact/">Contact</a><a href="/rss.xml">RSS</a><span>© {new Date().getUTCFullYear()} Wei-Yu Chen</span></div>
    </footer>
  </body>
</html>
