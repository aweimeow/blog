---
import Base from '../layouts/Base.astro';
import BlogShell from '../components/BlogShell.astro';
import PostCard from '../components/PostCard.astro';
import { articles } from '../data/site';
---
<Base><h1 class="sr-only">Wei-Yu Chen’s Blog</h1><BlogShell>{articles.map(article => <PostCard article={article} />)}<div class="end-note">You’re all caught up. Thanks for reading.</div></BlogShell></Base>
